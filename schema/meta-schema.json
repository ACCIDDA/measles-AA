{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "fullName",
    "dataDir",
    "fips",
    "sourceUrl",
    "sourceLabel"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z]{2}$"
    },
    "fullName": {
      "type": "string",
      "minLength": 1
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "fips": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{2}$"
    },
    "sourceUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "sourceLabel": {
      "type": "string",
      "minLength": 1
    }
  }
}
